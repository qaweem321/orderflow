# All three are required by compose.yaml. Generate each with the command shown.

# SQL Server "sa" password: 8+ characters with three of upper, lower, digit, symbol.
# echo "Of-$(openssl rand -hex 16)"
MSSQL_SA_PASSWORD=

# RabbitMQ password for the "orderflow" user. openssl rand -hex 24
RABBITMQ_PASSWORD=

# JWT signing key shared by the gateway and the services, at least 32 characters. openssl rand -base64 48
JWT_SIGNING_KEY=
