{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "" },
  "Database": { "MigrateOnStartup": false },
  "Seed": { "DemoUsers": false },
  "Jwt": { "Issuer": "orderflow", "Audience": "orderflow", "SigningKey": "", "Lifetime": "08:00:00" },
  "RateLimits": { "LoginsPerMinute": 10, "RequestsPerMinute": 600 },
  "ReverseProxyNetworks": [],
  "ReverseProxy": {
    "Routes": {
      "catalog": { "ClusterId": "catalog", "Match": { "Path": "/api/catalog/{**rest}" } },
      "orders": { "ClusterId": "ordering", "Match": { "Path": "/api/orders/{**rest}" } }
    },
    "Clusters": {
      "catalog": { "Destinations": { "main": { "Address": "http://localhost:5101" } } },
      "ordering": { "Destinations": { "main": { "Address": "http://localhost:5102" } } }
    }
  }
}
